    db.system.name: microsoft.sql_server&#xD;
    db.namespace: PortalTarefas_Tests_20261028_dfc3ccbe&#xD;
    server.address: localhost&#xD;
    db.query.text: SELECT TOP(?) [t].[Id], [t].[CriadaEm], [t].[Descricao], [t].[Equipe], [t].[Prazo], [t].[Prioridade], [t].[ProprietarioId], [t].[Publica], [t].[RowVersion], [t].[Situacao], [t].[Titulo]&#xD;
FROM [Tarefas] AS [t]&#xD;
WHERE ([t].[Publica] = CAST(? AS bit) OR [t].[Equipe] = @equipe) AND [t].[Id] = @id&#xD;
    db.query.summary: SELECT [Tarefas]&#xD;
