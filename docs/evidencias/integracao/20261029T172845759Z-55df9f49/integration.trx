    db.query.text: SET NOCOUNT ON;&#xD;
INSERT INTO [Auditorias] ([Acao], [Instante], [TarefaId], [UsuarioId])&#xD;
OUTPUT INSERTED.[Id]&#xD;
VALUES (@p0, @p1, @p2, @p3);&#xD;
UPDATE [Tarefas] SET [Descricao] = @p4, [Prazo] = @p5, [Prioridade] = @p6, [Titulo] = @p7&#xD;
OUTPUT INSERTED.[RowVersion]&#xD;
WHERE [Id] = @p8 AND [RowVersion] = @p9;&#xD;
    db.query.summary: INSERT&#xD;
