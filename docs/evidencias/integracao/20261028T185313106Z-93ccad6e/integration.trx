    db.query.text: SELECT [t].[Id], [t].[Titulo], [t].[Descricao], [t].[Situacao], [t].[Prioridade], [t].[Prazo], [t].[Equipe], [t].[Publica], [t].[ProprietarioId]&#xD;
FROM [Tarefas] AS [t]&#xD;
WHERE ([t].[Publica] = CAST(? AS bit) OR [t].[Equipe] = @equipe) AND ([t].[Titulo] LIKE @busca_contains ESCAPE ? OR ([t].[Descricao] IS NOT NULL AND [t].[Descricao] LIKE @busca_contains0 ESCAPE ?))&#xD;
ORDER BY [t].[Prazo], [t].[Id]&#xD;
OFFSET @p ROWS FETCH NEXT @p4 ROWS ONLY&#xD;
