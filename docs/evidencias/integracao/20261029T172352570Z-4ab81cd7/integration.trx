    db.query.text: SELECT COUNT(*)&#xD;
FROM [Tarefas] AS [t]&#xD;
WHERE ([t].[Publica] = CAST(? AS bit) OR [t].[Equipe] = @equipe) AND ([t].[Titulo] LIKE @busca_contains ESCAPE ? OR ([t].[Descricao] IS NOT NULL AND [t].[Descricao] LIKE @busca_contains0 ESCAPE ?))&#xD;
