    db.query.text: SELECT TOP(?) [t].[Id], [t].[CriadaEm], [t].[Descricao], [t].[Equipe], [t].[Prazo], [t].[Prioridade], [t].[ProprietarioId], [t].[Publica], [t].[RowVersion], [t].[Situacao], [t].[Titulo]&#xD;
