Activity.Tags:&#xD;
    db.system.name: microsoft.sql_server&#xD;
    db.namespace: PortalTarefas_Tests_R8_20261029_b9604ba3&#xD;
    server.address: localhost&#xD;
    db.query.text: SELECT TOP(?) COUNT(*), COUNT(CASE&#xD;
    WHEN [t0].[Situacao] = ? THEN ?&#xD;
END), COUNT(CASE&#xD;
    WHEN [t0].[Situacao] = ? THEN ?&#xD;
END), COUNT(CASE&#xD;
    WHEN [t0].[Prazo] &lt; @hoje AND [t0].[Situacao] &lt;&gt; ? THEN ?&#xD;
END)&#xD;
FROM (&#xD;
    SELECT [t].[Prazo], [t].[Situacao], ? AS [Key]&#xD;
    FROM [Tarefas] AS [t]&#xD;
    WHERE [t].[Publica] = CAST(? AS bit)&#xD;
) AS [t0]&#xD;
GROUP BY [t0].[Key]&#xD;
    db.query.summary: SELECT [t].[Prazo] [t].[Situacao] AS&#xD;
