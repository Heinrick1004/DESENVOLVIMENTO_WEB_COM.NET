    "/api/tarefas": {
      "get": {
        "tags": [
          "TarefasApi"
        ],
        "summary": "Lista tarefas visíveis, com filtros, ordenação permitida e páginas de até 50 itens.",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "ordenarPor",
            "in": "query",
            "schema": {
              "pattern": "^(prazo|titulo|prioridade|situacao|criadaem|id)$",
              "type": "string"
            }
          },
          {
            "name": "direcao",
            "in": "query",
            "schema": {
              "pattern": "^(asc|desc)$",
              "type": "string"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "schema": {
              "maxLength": 120,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "situacao",
            "in": "query",
            "schema": {
              "pattern": "^(Pendente|EmAndamento|Concluida)$",
              "type": "string"
            }
          },
          {
            "name": "prioridade",
            "in": "query",
            "schema": {
              "maximum": 3,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "vencidas",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemDetails"
                }
