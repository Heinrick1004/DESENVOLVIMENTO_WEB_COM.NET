# Copie para um arquivo local ignorado e preencha os segredos fora do Git.
# Os valores vazios abaixo precisam ser fornecidos antes de executar o Compose.
PORTAL_COMPOSE_PROJECT=portal-tarefas-tests
PORTAL_IMAGE_TAG=local
MSSQL_SA_PASSWORD=
# Preencha Password na conexao abaixo com o mesmo segredo definido para MSSQL_SA_PASSWORD.
PORTAL_SQL_CONNECTION=Server=db;Database=PortalTarefas_Tests_Docker;User ID=sa;Password=;Encrypt=True;TrustServerCertificate=True
PORTAL_HTTPS_CERTIFICATE_PATH=
PORTAL_HTTPS_CERTIFICATE_PASSWORD=
PORTAL_SEED_SAMPLE_DATA=false

# Para conservar o namespace anterior, escolha PORTAL_COMPOSE_PROJECT=portal-tarefas.
# A aplicacao nao migra nem executa seed automaticamente. A inicializacao e explicita:
# docker compose up -d db
# docker compose run --rm web --initialize
# docker compose up -d web
# O script Publish-Local.ps1 tambem oferece -InitializeDatabase, restrito ao prefixo de teste.
